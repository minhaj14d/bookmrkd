{
  "name": "bookmrkd-extension",
  "version": "2.0.0",
  "private": true,
  "description": "bookmrkd — AI-powered bookmark maintenance assistant",
  "author": "Minhajul Abedin <https://github.com/minhaj14d>",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/minhaj14d/bookmrkd.git"
  },
  "homepage": "https://github.com/minhaj14d/bookmrkd",
  "bugs": {
    "url": "https://github.com/minhaj14d/bookmrkd/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:all": "npm run build && npm run build:firefox",
    "firefox:run": "web-ext run -s dist-firefox --firefox-profile bookmrkd-dev",
    "lint": "node scripts/validate.mjs chromium",
    "lint:firefox": "node scripts/validate.mjs firefox",
    "lint:all": "npm run lint && npm run lint:firefox",
    "typecheck": "tsc --noEmit",
    "version:sync": "node scripts/sync-version.mjs",
    "pack": "node scripts/pack-release.mjs",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "^5.4.0",
    "tsx": "^4.19.2",
    "vite": "6.4.2",
    "web-ext": "^8.3.0"
  },
  "overrides": {
    "rollup": "2.80.0"
  }
}
