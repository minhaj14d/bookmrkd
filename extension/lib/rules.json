{
  "version": 1,
  "settings": {
    "max_folder_depth": 3,
    "fuzzy_duplicate_title_ratio": 0.88,
    "relevance_recency_weight": 30,
    "relevance_icon_bonus": 10,
    "relevance_generic_title_penalty": 12
  },
  "taxonomy": {
    "description": "Top-level folders used by built-in rules and the legacy classifier.",
    "tops": [
      "Learning",
      "Productivity",
      "Web Development",
      "Career & Jobs",
      "Design",
      "Entertainment",
      "Archive",
      "Security",
      "Research",
      "Data Science",
      "AI & Machine Learning",
      "Linux & Systems",
      "Mathematics"
    ]
  },
  "rules": [
    {
      "id": "short_links",
      "priority": 10000,
      "folder": ["Archive", "Short Links"],
      "any": [
        { "url_contains": "bit.ly/" },
        { "url_contains": "tinyurl.com/" },
        { "url_contains": "t.co/" },
        { "url_contains": "goo.gl/" },
        { "url_contains": "ow.ly/" },
        { "url_contains": "is.gd/" },
        { "url_contains": "buff.ly/" }
      ]
    },
    {
      "id": "social_networks",
      "priority": 9000,
      "folder": ["Archive", "Social & Leisure"],
      "any": [
        { "host_contains": "facebook.com" },
        { "host_contains": "instagram.com" },
        { "host_contains": "twitter.com" },
        { "host_contains": "x.com" },
        { "host_contains": "tiktok.com" },
        { "host_contains": "pinterest.com" },
        { "host_contains": "snapchat.com" },
        { "host_contains": "threads.net" },
        { "host_contains": "mastodon." },
        { "host_contains": "bsky.app" }
      ]
    },
    {
      "id": "social_chat",
      "priority": 8900,
      "folder": ["Productivity", "Communication"],
      "any": [
        { "host_contains": "discord.com" },
        { "host_contains": "discord.gg" },
        { "host_contains": "telegram.org" },
        { "host_contains": "web.telegram" },
        { "host_contains": "t.me" },
        { "host_contains": "whatsapp.com" },
        { "host_contains": "web.whatsapp" },
        { "host_contains": "signal.org" },
        { "host_contains": "slack.com" },
        { "host_contains": "teams.microsoft" },
        { "host_contains": "zoom.us" }
      ]
    },
    {
      "id": "shopping",
      "priority": 8800,
      "folder": ["Archive", "News & Shopping"],
      "any": [
        { "host_contains": "amazon." },
        { "host_contains": "ebay." },
        { "host_contains": "etsy.com" },
        { "host_contains": "walmart.com" },
