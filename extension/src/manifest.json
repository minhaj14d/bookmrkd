{
  "manifest_version": 3,
  "name": "bookmrkd — Bookmark Library",
  "short_name": "bookmrkd",
  "version": "1.1.0",
  "description": "Save, tag, and search bookmarks locally. Optional organize and Gemini assist in Advanced settings.",
  "permissions": [
    "bookmarks",
    "storage",
    "downloads",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "bookmrkd",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/conversion.png"
  }
}
