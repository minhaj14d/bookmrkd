{
  "manifest_version": 3,
  "name": "bookmrkd — Semantic Bookmark Organizer",
  "short_name": "bookmrkd",
  "version": "1.0.0",
  "description": "Dedupe and categorize bookmarks locally. Export clean HTML. Optional free Gemini assist.",
  "permissions": [
    "bookmarks",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "bookmrkd — Semantic Bookmark Organizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/conversion.png"
  }
}
