# Copy to .env in this folder (repo root). Used when building the extension (Vite loads from here).
#
# Raindrop.io — bookmrkd extension (baked into dist at build time; reload extension after changing)
# OAuth app: https://app.raindrop.io/settings/integrations — docs: https://developer.raindrop.io/v1/authentication/token
# VITE_RAINDROP_CLIENT_ID=your_client_id
# VITE_RAINDROP_CLIENT_SECRET=your_client_secret
# Optional: use Test token from app settings instead of OAuth (personal testing only)
# VITE_RAINDROP_TEST_TOKEN=
#
# CLI / other tools (optional)
# GEMINI_API_KEY=your_key_from_https://aistudio.google.com/apikey
# OPENAI_API_KEY=
